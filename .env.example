# Application
LEARNLOOP_ENVIRONMENT=development
LEARNLOOP_DATA_DIR=./data

# Model provider: keep "none" for the deterministic fallback, or use "deepseek".
LEARNLOOP_LLM_PROVIDER=none
LEARNLOOP_LLM_MODEL=deepseek-v4-flash
LEARNLOOP_LLM_API_KEY=
LEARNLOOP_LLM_BASE_URL=https://api.deepseek.com
LEARNLOOP_LLM_TIMEOUT_SECONDS=60
LEARNLOOP_LLM_MAX_RETRIES=2

# Completed/failed Agent checkpoints are retained for this many days.
LEARNLOOP_CHECKPOINT_RETENTION_DAYS=30

# dynamic_v2 starts in read-only Shadow mode. Enable writes only after evaluation.
LEARNLOOP_AGENT_DYNAMIC_WRITES_ENABLED=false
LEARNLOOP_AGENT_MAX_STEPS=24
LEARNLOOP_AGENT_MAX_MODEL_CALLS=30
LEARNLOOP_AGENT_MAX_TOOL_CALLS=20
LEARNLOOP_AGENT_MAX_INPUT_TOKENS=60000
LEARNLOOP_AGENT_MAX_OUTPUT_TOKENS=20000
LEARNLOOP_AGENT_MAX_TOTAL_TOKENS=80000
LEARNLOOP_AGENT_DEADLINE_SECONDS=300
LEARNLOOP_AGENT_MAX_SAME_ACTION=2
LEARNLOOP_AGENT_MAX_CONSECUTIVE_FAILURES=3
LEARNLOOP_AGENT_MAX_REPLANS=2
LEARNLOOP_AGENT_CONTEXT_TOKENS=12000
LEARNLOOP_AGENT_CONTEXT_OUTPUT_RESERVE_TOKENS=2048
LEARNLOOP_AGENT_CONTEXT_RECENT_OBSERVATIONS=24
LEARNLOOP_AGENT_CONTEXT_SOURCE_TTL_SECONDS=86400
# Stores full compiled Context locally. Keep false outside explicit debugging.
LEARNLOOP_AGENT_CONTEXT_DEBUG_FULL=false
# Active Memory is an optional Context partition and can be disabled for ablation.
LEARNLOOP_AGENT_MEMORY_ENABLED=true
LEARNLOOP_AGENT_MEMORY_RECALL_LIMIT=6
LEARNLOOP_AGENT_MEMORY_MINIMUM_SCORE=0.24

# Bounded local-only Agentic RAG / Research Tutor.
LEARNLOOP_RESEARCH_MAX_ROUNDS=3
LEARNLOOP_RESEARCH_MAX_QUERIES=8
LEARNLOOP_RESEARCH_MAX_SOURCES=12
LEARNLOOP_RESEARCH_MAX_READ_CHARS=30000
LEARNLOOP_RESEARCH_MAX_CONTEXT_TOKENS=8000

# Embedding provider: "local" is offline; "openai_compatible" uses /embeddings.
LEARNLOOP_EMBEDDING_PROVIDER=local
LEARNLOOP_EMBEDDING_MODEL=text-embedding-3-small
LEARNLOOP_EMBEDDING_API_KEY=
LEARNLOOP_EMBEDDING_BASE_URL=https://api.openai.com/v1
LEARNLOOP_EMBEDDING_DIMENSIONS=384

# Local resource ingestion
LEARNLOOP_RESOURCE_MAX_BYTES=20971520
LEARNLOOP_RESOURCE_CHUNK_SIZE=1000
LEARNLOOP_RESOURCE_CHUNK_OVERLAP=150
LEARNLOOP_WEB_FETCH_TIMEOUT_SECONDS=20

# Persistent SQLite background worker
LEARNLOOP_WORKER_POLL_INTERVAL_SECONDS=0.5
LEARNLOOP_WORKER_LEASE_SECONDS=60
LEARNLOOP_JOB_MAX_ATTEMPTS=3
LEARNLOOP_JOB_RETRY_BASE_SECONDS=2
LEARNLOOP_JOB_RETRY_MAX_SECONDS=60
